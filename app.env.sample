# Mattermost Team Edition - Environment Variables
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Host settings
BASE_HOST_NAME=mattermost.example.com
BASE_DOMAIN_NAME=example.com

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=mattermost
DB_USER_NAME=dbadmin
DB_USER_PASS=changeme_db_password

# Admin account (created on first run)
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password
APP_USER_NAME=administrator
